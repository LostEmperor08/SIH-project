# =====================================================================
# Chakravyuh SETU — backend environment
# Copy to .env and fill in. NOTHING here has a working default: the app
# fails closed rather than starting with authentication disabled.
# =====================================================================

ENVIRONMENT=development            # development | staging | production

# ---- Supabase (required) --------------------------------------------
SUPABASE_URL=https://<your-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=         # server-side only, never sent to a browser

# ---- CORS (required in production; '*' is refused there) ------------
CORS_ORIGINS=http://localhost:5173

# ---- Machine-to-machine auth (optional) -----------------------------
# Must be >= 32 chars or it is treated as not configured.
SERVICE_API_KEY=

# =====================================================================
# CHAIN DATA PROVIDERS
# =====================================================================

# ---- Bitcoin: Blockstream Esplora. No key needed. -------------------
BTC_API=https://blockstream.info/api

# ---- Ethereum + Polygon + BSC: Etherscan V2 -------------------------
# ONE free key covers all of them — chainid selects the chain
# (1 = Ethereum, 137 = Polygon, 56 = BSC). REQUIRED for these chains.
# Get one at https://etherscan.io/apis
ETHERSCAN_API=https://api.etherscan.io/v2/api
ETHERSCAN_API_KEY=

# ---- Tron: TronGrid -------------------------------------------------
# The key is OPTIONAL — TronGrid answers without one, but unkeyed
# requests are rate-limited hard enough to stall a live multi-hop trace.
# Free key at https://www.trongrid.io
TRON_API=https://api.trongrid.io
TRONGRID_API_KEY=

# ---- Pricing --------------------------------------------------------
COINGECKO_URL=https://api.coingecko.com/api/v3/simple/price
PRICE_CACHE_SECONDS=300

# =====================================================================
# ML SERVICE (optional)
# Unset -> /trace still scores every wallet with the in-gateway
# heuristic engine and reports scoringMode:"heuristic".
# =====================================================================
ML_API_URL=
ML_API_KEY=

# ---- Tracing limits -------------------------------------------------
MAX_HOPS=3
MAX_ADDRESSES_PER_HOP=40
CHAIN_CONCURRENCY=6
TRACE_RATE_LIMIT_REQUESTS=10
